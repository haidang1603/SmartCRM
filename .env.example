# ==============================================================================
# SmartCRM - Environment Configuration Template
# Copy this file to .env and configure strong production credentials before deployment.
# DO NOT commit real secrets or production passwords into version control!
# ==============================================================================

# Application Environment Profile
# Options: dev, mysql, prod
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (MySQL 8.0)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=smartcrm
DB_USER=smartcrm_user
# CHANGE IN PRODUCTION: Use a high-entropy password (min 16 chars)
DB_PASSWORD=ChangeMeInProd_SecureDbPass123!
MYSQL_ROOT_PASSWORD=ChangeMeInProd_RootSecurePass123!

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Message Broker
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=smartcrm
# CHANGE IN PRODUCTION: Use a strong password
RABBITMQ_PASSWORD=ChangeMeInProd_RabbitPass123!

# JWT Authentication & Authorization
# MUST be at least 256 bits (32 characters or base64) of cryptographically random text
JWT_SECRET=ReplaceWithAStrongSecretKeyAtLeast256BitsLongForProductionSecurity2026!
# Token expiration in milliseconds (43200000 = 12 hours)
JWT_EXPIRATION_MS=43200000

# Report Files & Storage Settings
REPORT_STORAGE_DIR=/app/storage/reports
REPORT_EXPIRATION_HOURS=24

# CORS Security Allowed Origins (Comma-separated list)
CORS_ALLOWED_ORIGINS=https://crm.yourdomain.com,http://localhost,http://localhost:80

# Frontend Exposed Ports
FRONTEND_PORT=80
FRONTEND_DEV_PORT=5173
